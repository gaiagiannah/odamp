# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://odamp:odamp_dev@localhost:5432/odamp
REDIS_URL=redis://localhost:6379

# ─── API ────────────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRY_HOURS=24

# ─── Blockchain RPC ─────────────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org
SEPOLIA_RPC_URL=https://sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── Pricing ────────────────────────────────────────────────
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ─── AI Agent (Phase 4) ─────────────────────────────────────
AI_AGENT_URL=http://localhost:8000
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0

# ─── Execution (Phase 5) ────────────────────────────────────
ONEINCH_API_KEY=
ONEINCH_BASE_URL=https://api.1inch.dev

# ─── OFAC ───────────────────────────────────────────────────
OFAC_SDN_URL=https://sanctions.ofac.treas.gov/api/sdn/v1/sdnList
OFAC_REFRESH_HOURS=24

# ─── Key Storage ────────────────────────────────────────────
KEYS_DIR=~/.odamp/keys
KEY_ENCRYPTION_PASSWORD=   